# Test Case: Single replica split with replication
#
# This tests splitting a range with a single replica, then replicating both
# halves to a second store:
# 1. Initialize 2-store cluster
# 2. Flush on store 1
# 3. Split range 1 into ranges 1 (LHS) and 2 (RHS)
# 4. Verify RSEngine state for both ranges on store 1
# 5. Add replicas for both ranges to store 2
# 6. Verify range-shared-meta-keys on store 2

init stores=2
----
cluster started with 2 store(s)

scratch-range
----
ok

# Flush before split to create SST files.
flush rangeID=1 store=1
----
flushed

# Split the range. LHS keeps synthetic ID 1, RHS gets synthetic ID 2.
# After split, both ranges get new manifests written.
split rangeID=1 store=1
----
split ok, lhs=1 rhs=2

# Verify RSEngine state for both ranges on store 1.
# After split, both LHS and RHS have the same manifest (286) since they
# share the same SST file.
rs-engine-state rangeID=1 store=1
----
current-manifest: 286
manifest 286: refcount=1 sstables=[000225.sst]

rs-engine-state rangeID=2 store=1
----
current-manifest: 286
manifest 286: refcount=1 sstables=[000225.sst]

# Add replicas for both ranges to store 2.
add-replica rangeID=1 store=2
----
added replica to store 2, replicas: 2

add-replica rangeID=2 store=2
----
added replica to store 2, replicas: 2

# Verify range-shared-meta-keys on store 2.
range-shared-meta-keys rangeID=1 store=2
----
RSManifestState:
  disk_file_num: 286, replica_id: 2
RangeFileNumAllocState:
  next_file_num: 327

range-shared-meta-keys rangeID=2 store=2
----
