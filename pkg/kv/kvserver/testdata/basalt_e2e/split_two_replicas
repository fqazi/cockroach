# Test Case: Split with two replicas
#
# This tests splitting a range that already has two replicas:
# 1. Initialize 2-store cluster
# 2. Flush on store 1
# 3. Add replica to store 2
# 4. Split range 1 (lhs=1, rhs=2)
# 5. Verify state on both stores for both ranges

init stores=2
----
cluster started with 2 store(s)

scratch-range
----
ok

# Flush before adding replica.
flush rangeID=1 store=1
----
flushed

# Add replica to store 2.
add-replica rangeID=1 store=2
----
added replica to store 2, replicas: 2

# Split with 2 replicas. Both halves replicate to both stores.
split rangeID=1 store=1
----
split ok, lhs=1 rhs=2

# Verify range-shared-meta-keys on both stores for both ranges.
# After split, all replicas share the same manifest 286 with SST 000225.
range-shared-meta-keys rangeID=1 store=1
----
RSManifestState:
  disk_file_num: 286, replica_id: 1
RangeFileNumAllocState:
  next_file_num: 327

range-shared-meta-keys rangeID=1 store=2
