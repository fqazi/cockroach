# Test Case: Flush error handling on non-leaseholder
#
# This tests that flush fails on a non-leaseholder replica:
# 1. Initialize 2-store cluster
# 2. Flush on leaseholder (store 1) succeeds
# 3. Add replica to store 2
# 4. Transfer lease to store 2
# 5. Flush on store 1 (now non-leaseholder) should fail
# 6. Flush on store 2 (new leaseholder) should succeed

init stores=2
----
cluster started with 2 store(s)

scratch-range
----
ok

# Initial flush on leaseholder (store 1).
flush rangeID=1 store=1
----
flushed

# Add replica to store 2.
add-replica rangeID=1 store=2
----
added replica to store 2, replicas: 2

# Transfer lease to store 2.
transfer-lease rangeID=1 store=2
----
lease transferred to store 2

# Flush on store 1 (non-leaseholder) should fail.
flush rangeID=1 store=1
----
error: not the leaseholder

# Flush on store 2 (new leaseholder) should succeed.
flush rangeID=1 store=2
----
flushed

# Verify state on both stores.
range-shared-meta-keys rangeID=1 store=1
