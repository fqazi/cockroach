# Basic test: store-local engine TrySchedule and Done.

init max-concurrency=4 depri-ratio=1.0
----
ok

open-engine name=sl type=store-local allowed=4
----
ok

# TrySchedule succeeds immediately (running=0, global=0).
try-schedule name=sl
----
granted handle=sl

status
----
global-running: 1
rs-heap-size: 0
unprobed-size: 0
  sl: running=1 waiting=false
scheduled-counts: sl=0

# Done decrements counters.
done handle=sl
----
ok

status
----
global-running: 0
rs-heap-size: 0
unprobed-size: 0
  sl: running=0 waiting=false
scheduled-counts: sl=0

# TrySchedule respects per-engine limit.
set-allowed name=sl allowed=1
----
ok

try-schedule name=sl
----
granted handle=sl

# Second TrySchedule denied (per-engine limit=1, running=1).
try-schedule name=sl
----
denied

status
----
global-running: 1
rs-heap-size: 0
unprobed-size: 0
  sl: running=1 waiting=true
scheduled-counts: sl=0

done handle=sl
----
ok

