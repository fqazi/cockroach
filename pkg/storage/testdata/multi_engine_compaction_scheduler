# Test RS engine not lost after grant+done cycle.
#
# Previously, when an RS engine was granted from the heap via poke, the
# scheduler removed it from the heap but left waiting=true without adding
# it to the unprobed list. After Done, the engine was invisible to future
# pokes — it had waiting=true but was in neither the heap nor the unprobed
# list.

init max-concurrency=4 depri-ratio=1.0
----
ok

open-engine name=rs1 type=range-shared allowed=1
----
ok

set-waiting name=rs1 optional=false priority=80 score=3.0
----
ok

# Deny TrySchedule to put rs1 in unprobed.
set-max-concurrency max=0
----
ok

try-schedule name=rs1
----
denied

status
----
global-running: 0
rs-heap-size: 0
unprobed-size: 1
  rs1: running=0 waiting=true in-unprobed
scheduled-counts: rs1=0

# Raise limit and poke. rs1 drains from unprobed into heap, gets scheduled.
set-max-concurrency max=1
----
ok

poke
----
ok

# rs1 is running. With the fix, it's also in the unprobed list (moved there
# by tryInvalidateRememberedStateLocked before Schedule was called).
status
----
global-running: 1
rs-heap-size: 0
unprobed-size: 1
  rs1: running=1 waiting=true in-unprobed
scheduled-counts: rs1=1

# Complete the compaction.
done handle=rs1
----
ok

status
----
global-running: 0
rs-heap-size: 0
unprobed-size: 1
  rs1: running=0 waiting=true in-unprobed
scheduled-counts: rs1=1

# Set new work and poke. The engine should be discoverable and scheduled.
set-waiting name=rs1 optional=false priority=80 score=5.0
----
ok

poke
----
ok

# rs1 is scheduled again — it was not lost.
status
----
global-running: 1
rs-heap-size: 0
unprobed-size: 1
  rs1: running=1 waiting=true in-unprobed
scheduled-counts: rs1=2

done handle=rs1
----
ok

close-engine name=rs1
----
ok
