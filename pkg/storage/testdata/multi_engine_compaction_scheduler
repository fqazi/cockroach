# Test poke-driven granting with store-local and range-flusher.

set-max-concurrency max=4
----
ok

# Set waiting compaction data for both engines.
set-waiting name=sl optional=false priority=80 score=2.0
----
ok

set-waiting name=rf optional=false priority=60 score=1.0
----
ok

# Mark both as waiting via TrySchedule that gets denied (per-engine limit=0).
set-allowed name=sl allowed=0
----
ok

set-allowed name=rf allowed=0
----
ok

try-schedule name=sl
----
denied

try-schedule name=rf
----
denied

status
----
global-running: 0
rs-heap-size: 0
unprobed-size: 0
  rf: running=0 waiting=true
  sl: running=0 waiting=true
scheduled-counts: rf=0 sl=0

# Now raise limits and poke. Both should get scheduled. The WC is consumed
# by Schedule, so the poke also clears waiting via GetWaitingCompaction
# returning false.
