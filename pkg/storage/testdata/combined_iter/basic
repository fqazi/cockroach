# Empty secondary: no shared data, iteration works like normal.
# (Using non-combined iter is equivalent since secondary is empty for
# the non-combined case. Here we test that SetSecondaryLSM with an
# empty secondary doesn't break anything — the shared data written
# earlier is still visible via the vh.)

# Multiple iterators from the same reader: reuse + clone paths.
combined-iter type=readonly
----
ok

seek-ge key=a
----
a/10: a10

# Close first iter, create second from same reader (reuse path).
close-iter
----
ok

combined-iter type=readonly
----
ok

seek-ge key=d
----
d/3: d3

close-iter
----
ok

close-reader
----
ok
