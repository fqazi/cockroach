# Test multi-SST straddling split with a multi-level LSM. Three sequential
# ingests with overlapping key ranges produce a multi-level LSM (the first
# ingest sinks to L6; the next two overlap and stack into L0 sublevels). All
# three SSTs straddle the split key, so each gets virtualized into LHS/RHS
# halves on Split.

init
----

open range=r1 manifest=0
----
opened r1: manifest=0

ingest range=r1
set a val-a
set s val-s
----
GetFileNums(2) => [100, 102)
InstallNewManifest(current=0, new=MANIFEST-000101/101, files=[{000100.sst 100}])
ingested: manifest=101

ingest range=r1
set b val-b
set t val-t
----
GetFileNums(2) => [102, 104)
InstallNewManifest(current=101, new=MANIFEST-000103/103, files=[{000102.sst 102}])
ingested: manifest=103

ingest range=r1
set c val-c
set u val-u
----
GetFileNums(2) => [104, 106)
InstallNewManifest(current=103, new=MANIFEST-000105/105, files=[{000104.sst 104}])
ingested: manifest=105

snapshot range=r1
----
snapshot r1-105

split snapshot=r1-105 key=g rhs-range=r2
----
lhs-manifest: MANIFEST-000109/109
rhs-manifest: MANIFEST-000110/110
rhs-files: [3 files]
next-file-num: 112
reopened r1: manifest=109
opened r2: manifest=110

scan range=r1
----
"a" = val-a
"b" = val-b
"c" = val-c

scan range=r2
----
"s" = val-s
"t" = val-t
"u" = val-u

close range=r1
----
closed: r1

close range=r2
----
closed: r2
